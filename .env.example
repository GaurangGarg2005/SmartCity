# SmartCity — Environment Variable Reference
# Copy this file to .env and fill in values for local development.
# NEVER commit the actual .env file. It is in .gitignore.
# Production: set these in Render's "Environment" dashboard (not in render.yaml).

# ─── Server ───────────────────────────────────────────────────────────────────
# Port the server listens on. Render sets $PORT automatically.
PORT=8080

# Allowed CORS origin (set to your deployed URL in production).
# Use * only for local dev.
CORS_ORIGIN=http://localhost:8080

# Optional admin PIN to protect POST /api/sim/control and POST /api/sim/incident.
# Leave blank to allow unauthenticated access (suitable for open demos).
ADMIN_PIN=

# ─── Simulation ───────────────────────────────────────────────────────────────
# Initial vehicle count (1–2000).
SIM_VEHICLES=500

# Random seed for deterministic simulation. 0 = random seed each run.
SIM_SEED=0

# Simulation tick rate multiplier (1–10).
SIM_SPEED=1

# Weight model: "greenshields" (default) or "bpr".
WEIGHT_MODEL=greenshields

# ─── Feature flags ────────────────────────────────────────────────────────────
# Set to "true" to enable TomTom traffic flow calibration.
# Requires TOMTOM_API_KEY. See docs/DEPLOYMENT.md for terms and quota notes.
ENABLE_TOMTOM=false
TOMTOM_API_KEY=

# Set to "true" to enable Photon geocoder fallback for /api/search.
# Requires a self-hosted or consented Photon instance; do NOT use
# the public photon.komoot.io endpoint in production without permission.
ENABLE_PHOTON=false
PHOTON_BASE_URL=

# Open-Meteo weather integration (no key required). Enabled by default.
ENABLE_WEATHER=true

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Maximum HTTP requests per minute per IP.
RATE_LIMIT_HTTP=60

# Maximum WebSocket messages per second per connection.
RATE_LIMIT_WS=10

# ─── Logging ──────────────────────────────────────────────────────────────────
# Log level: debug | info | warn | error
LOG_LEVEL=info
